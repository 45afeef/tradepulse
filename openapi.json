{
  "components": {
    "schemas": {
      "Condition": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "description": "Built-in (type, source, title, summary, url, entity) or a payload field; see GET /event-types",
            "maxLength": 40,
            "type": "string"
          },
          "op": {
            "enum": [
              "\u003e",
              "\u003e=",
              "\u003c",
              "\u003c=",
              "==",
              "!=",
              "in",
              "contains",
              "any_of"
            ],
            "type": "string"
          },
          "value": {
            "description": "number, string or boolean; an array for in / any_of"
          }
        },
        "required": [
          "field",
          "op",
          "value"
        ],
        "type": "object"
      },
      "CredentialsBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "examples": [
              "trader@example.com"
            ],
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "examples": [
              "a-long-password"
            ],
            "maxLength": 128,
            "minLength": 10,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "EventTypesBody": {
        "additionalProperties": false,
        "properties": {
          "builtin_fields": {
            "description": "Available on every event; usable in conditions",
            "items": {
              "$ref": "#/components/schemas/FieldDef"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "types": {
            "items": {
              "$ref": "#/components/schemas/TypeDef"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "types",
          "builtin_fields"
        ],
        "type": "object"
      },
      "FeedBody": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FeedItem"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "FeedItem": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "entities": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "event_id": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "reason": {
            "description": "Why this item matched (explainability)",
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "event_id",
          "event_type",
          "source",
          "entities",
          "title",
          "body",
          "severity",
          "reason",
          "created_at"
        ],
        "type": "object"
      },
      "FieldDef": {
        "additionalProperties": false,
        "properties": {
          "doc": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "type": "object"
      },
      "Profile": {
        "additionalProperties": false,
        "properties": {
          "muted": {
            "description": "Entities, sources or phrases that suppress matching items",
            "items": {
              "type": "string"
            },
            "maxItems": 200,
            "type": [
              "array",
              "null"
            ]
          },
          "subscriptions": {
            "items": {
              "$ref": "#/components/schemas/Subscription"
            },
            "maxItems": 200,
            "type": [
              "array",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "PublicUser": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "created_at"
        ],
        "type": "object"
      },
      "StatusBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "examples": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Subscription": {
        "additionalProperties": false,
        "properties": {
          "conditions": {
            "description": "All conditions must hold for an item to be delivered",
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "maxItems": 10,
            "type": [
              "array",
              "null"
            ]
          },
          "kind": {
            "description": "entity: matches event entities; keyword: whole-word phrase in title/summary; source: events from a source id",
            "enum": [
              "entity",
              "keyword",
              "source"
            ],
            "type": "string"
          },
          "types": {
            "description": "Only these event types (empty = all types)",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "type": [
              "array",
              "null"
            ]
          },
          "value": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "value"
        ],
        "type": "object"
      },
      "TicketBody": {
        "additionalProperties": false,
        "properties": {
          "expires_in": {
            "examples": [
              30
            ],
            "format": "int64",
            "type": "integer"
          },
          "ticket": {
            "description": "Single-use; connect to /ws?ticket=\u003cticket\u003e within expires_in seconds",
            "type": "string"
          }
        },
        "required": [
          "ticket",
          "expires_in"
        ],
        "type": "object"
      },
      "TokenBody": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "description": "JWT; send as 'Authorization: Bearer \u003ctoken\u003e'",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/PublicUser"
          }
        },
        "required": [
          "token",
          "user"
        ],
        "type": "object"
      },
      "TypeDef": {
        "additionalProperties": false,
        "properties": {
          "body_template": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldDef"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "title_template": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "fields",
          "title_template",
          "body_template",
          "severity"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Personalized real-time information API. Real-time feed: WebSocket `GET /ws?ticket=` (not representable in OpenAPI; see README).",
    "title": "TradePulse API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Log in and get a JWT",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "signup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenBody"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Create an account",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/event-types": {
      "get": {
        "operationId": "list-event-types",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventTypesBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Event types and the fields usable in subscription conditions",
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/me/feed": {
      "get": {
        "operationId": "get-feed",
        "parameters": [
          {
            "description": "Max items, newest first",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "description": "Max items, newest first",
              "format": "int64",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Recent feed items (newest first)",
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/me/subscriptions": {
      "get": {
        "operationId": "get-subscriptions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get my subscriptions and mutes",
        "tags": [
          "me"
        ]
      },
      "put": {
        "operationId": "put-subscriptions",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Profile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Replace my subscriptions and mutes",
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/ws-ticket": {
      "post": {
        "operationId": "ws-ticket",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a one-time, 30s ticket for GET /ws?ticket=",
        "tags": [
          "me"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "ops"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "ops"
        ]
      }
    }
  }
}
