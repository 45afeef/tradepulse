# Copy to .env (dev) or inject from a secret manager (prod). Never commit real secrets.
# Every provider-specific value lives here: switching Postgres provider, GCP project or
# X account means changing these variables only, never code.

# ---- App ----
APP_ENV=development            # development | production
ADDR=:8080
# Generate: openssl rand -base64 48   (>= 32 chars; "change-me*" is rejected in production)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_TTL=15m                    # access token lifetime (short; clients renew with the refresh token)
REFRESH_TTL=720h               # refresh token lifetime (rotating, revocable)
SHUTDOWN_TIMEOUT=8s            # Cloud Run allows 10 s after SIGTERM
TRUSTED_PROXY_HOPS=1           # with TRUST_PROXY=true: proxies in front (Cloud Run direct: 1; behind an external load balancer: 2)
METRICS_TOKEN=                 # set (>=24 chars) to enable GET /metrics with "Authorization: Bearer <token>"
ALLOWED_ORIGINS=http://localhost:3000   # comma-separated browser origins (CORS + WebSocket)
TRUST_PROXY=false              # true ONLY behind a trusted reverse proxy
DOCS_ENABLED=                  # empty = on in development, off in production
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
LOG_LEVEL=info

# ---- Database (any managed Postgres: Supabase, AWS RDS/Aurora, GCP Cloud SQL, Neon...) ----
# Required in production. If empty in development, data is kept in memory (lost on restart).
# Supabase: use the *Supavisor pooler* connection string (works over IPv4, e.g. Cloud Run).
DATABASE_URL=
# Optional direct / session-mode URL used ONLY for migrations (advisory lock needs a session).
# Supabase: direct connection or the pooler's session mode (port 5432). Defaults to DATABASE_URL.
DATABASE_MIGRATION_URL=
DB_MAX_CONNS=10                # keep below your plan's connection limit
DB_SIMPLE_PROTOCOL=auto        # auto | true | false. auto = simple protocol for pgbouncer=true or port 6543
                               # (transaction-mode poolers do not support prepared statements)

# ---- First admin (set BOTH; created once if the email does not exist; password >= 12 chars) ----
# Remove from the environment after the first successful start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Sources (used from M3/M4) ----
SIM_DEMO=market                # market | status | none (production default: none)
SIM_INTERVAL=2s
SIM_SYMBOLS=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK,SBIN,ITC,LT,BHARTIARTL,TATAMOTORS
# Bounds for per-source polling intervals (each source sets its own within these bounds).
SOURCE_MIN_INTERVAL_SECONDS=60
SOURCE_MAX_INTERVAL_SECONDS=86400
# Optional: User-Agent for outbound source requests (default "TradePulse/1.0 (+source-reader)").
FETCH_USER_AGENT=
# X (Twitter) developer account: official API only (D-011). Spend is capped (D-018).
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com
X_MONTHLY_BUDGET_USD=20        # hard cap; polling stops when reached (0 = never call X)
X_COST_PER_RESOURCE_USD=0.005  # price per post/user read on your X plan: keep in sync with X pricing
X_MAX_POSTS_PER_FETCH=20       # 5-100 per poll
# X sources are available only when X_BEARER_TOKEN is set.

# ---- Inbound webhooks ----
# Per-source secrets are derived from this key (nothing secret is stored). Generate: openssl rand -base64 48
# Leave empty to disable inbound webhooks.
WEBHOOK_SIGNING_KEY=
WEBHOOK_RATE_PER_MINUTE=60     # per webhook source

# ---- Alerts ----
ALERT_MAX_FIRES_PER_HOUR=30    # a rule firing more often than this in an hour is paused automatically

# ---- Deploy-time only (GitHub Actions variables/secrets; not read by the app) ----
# GCP_PROJECT_ID=
# GCP_REGION=
# CLOUD_RUN_SERVICE=
